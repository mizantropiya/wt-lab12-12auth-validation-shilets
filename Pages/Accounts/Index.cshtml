@page
@model WtLab12Banking.AuthValidation.Pages.Accounts.IndexModel
@{
    ViewData["Title"] = "Банковские счета";
}

<div class="page-header catalog-header">
    <div>
        <h1>Банковские счета</h1>
        <div class="small text-secondary">Записей из PostgreSQL: @Model.Accounts.Count</div>
    </div>
    <a class="btn btn-dark" asp-page="./Create">Создать счёт</a>
</div>

<form method="get" class="search-form mb-4">
    <div class="input-group search-group">
        <input asp-for="Search" class="form-control" placeholder="Поиск по номеру, владельцу или названию" />
        <button type="submit" class="btn btn-outline-dark">Найти</button>
        @if (!string.IsNullOrWhiteSpace(Model.Search))
        {
            <a class="btn btn-outline-secondary" asp-page="./Index">Сбросить</a>
        }
    </div>
</form>

<div class="row g-3 account-grid">
    @foreach (var account in Model.Accounts)
    {
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm rounded account-card">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                        <span class="badge text-bg-light border account-type">@account.AccountType</span>
                        <span class="small text-secondary">#@account.Id</span>
                    </div>

                    <h5 class="card-title">@(account.Nickname ?? account.AccountNumber)</h5>
                    <div class="small text-secondary mb-1">@account.AccountNumber</div>
                    <div class="small text-secondary mb-3">@account.OwnerName</div>
                    <div class="money mb-2">@account.Balance.ToString("F2") @account.Currency</div>
                    @if (!string.IsNullOrWhiteSpace(account.Description))
                    {
                        <div class="small text-secondary account-description">@account.Description</div>
                    }

                    <div class="account-actions mt-auto pt-3">
                        <a class="btn btn-sm btn-outline-dark" title="Подробнее" asp-page="./Details" asp-route-id="@account.Id">◉</a>
                        <a class="btn btn-sm btn-outline-secondary" title="Изменить" asp-page="./Edit" asp-route-id="@account.Id">✎</a>
                        <a class="btn btn-sm btn-outline-danger" title="Удалить" asp-page="./Delete" asp-route-id="@account.Id">×</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (Model.Accounts.Count == 0)
{
    <div class="empty-state">По вашему запросу ничего не найдено</div>
}
