@page
@model WtLab12Banking.AuthValidation.Pages.Accounts.CreateModel
@{
    ViewData["Title"] = "Создать счёт";
}

<section class="centered-page form-page">
<div class="page-header">
    <h1>Создать счёт</h1>
</div>

<div class="card form-card-bootstrap shadow-sm rounded">
    <div class="card-body p-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="validation mb-3"></div>

            <div class="mb-3">
                <label asp-for="Input.AccountNumber" class="form-label"></label>
                <input asp-for="Input.AccountNumber" class="form-control" />
                <span asp-validation-for="Input.AccountNumber" class="validation"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.OwnerName" class="form-label"></label>
                <input asp-for="Input.OwnerName" class="form-control" />
                <span asp-validation-for="Input.OwnerName" class="validation"></span>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-12 col-sm-5">
                    <label asp-for="Input.Currency" class="form-label"></label>
                    <input asp-for="Input.Currency" class="form-control" />
                    <span asp-validation-for="Input.Currency" class="validation"></span>
                </div>
                <div class="col-12 col-sm-7">
                    <label asp-for="Input.Balance" class="form-label"></label>
                    <input asp-for="Input.Balance" class="form-control" />
                    <span asp-validation-for="Input.Balance" class="validation"></span>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="Input.Nickname" class="form-label"></label>
                <input asp-for="Input.Nickname" class="form-control" />
                <span asp-validation-for="Input.Nickname" class="validation"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.AccountType" class="form-label"></label>
                <select asp-for="Input.AccountType" class="form-select">
                    <option>Обычный счёт</option>
                    <option>Сберегательный</option>
                    <option>Кредитный</option>
                    <option>Бизнес-счёт</option>
                </select>
                <span asp-validation-for="Input.AccountType" class="validation"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Input.Description" class="form-label"></label>
                <textarea asp-for="Input.Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Input.Description" class="validation"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-dark">Создать</button>
                <a class="btn btn-outline-secondary" asp-page="./Index">Назад</a>
            </div>
        </form>
    </div>
</div>

</section>
