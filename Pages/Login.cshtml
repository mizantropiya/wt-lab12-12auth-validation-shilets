@page
@model WtLab12Banking.AuthValidation.Pages.LoginModel
@{
    ViewData["Title"] = "Вход";
}

<div class="page-header">
    <h1>Вход</h1>
</div>

<div class="card form-card-bootstrap shadow-sm rounded auth-card">
    <div class="card-body p-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="validation mb-3"></div>

            <div class="mb-3">
                <label asp-for="Login" class="form-label">Логин</label>
                <input asp-for="Login" class="form-control" autocomplete="username" />
                <span asp-validation-for="Login" class="validation"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Password" class="form-label">Пароль</label>
                <input asp-for="Password" class="form-control" type="password" autocomplete="current-password" />
                <span asp-validation-for="Password" class="validation"></span>
            </div>

            <button type="submit" class="btn btn-dark">Войти</button>
        </form>

        <div class="auth-hint mt-4">
            Учебная учётная запись: <strong>student</strong> / <strong>1234</strong>
        </div>
    </div>
</div>
