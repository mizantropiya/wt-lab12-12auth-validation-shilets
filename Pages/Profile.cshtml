@page
@model WtLab12Banking.AuthValidation.Pages.ProfileModel
@{
    ViewData["Title"] = "Личный кабинет";
}

<section class="centered-page auth-page">
<div class="page-header">
    <h1>Личный кабинет</h1>
</div>

<div class="card details-card shadow-sm rounded auth-card">
    <div class="card-body p-4">
        <p class="mb-2 text-secondary">Пользователь</p>
        <p class="fs-5 mb-4"><strong>@Model.UserLogin</strong></p>


        <form method="post">
            <button type="submit" class="btn btn-outline-danger">Выйти</button>
        </form>
    </div>
</div>

</section>
